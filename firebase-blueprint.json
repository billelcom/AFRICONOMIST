{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public and private user profile data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["reader", "editor", "admin"] },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "SavedArticle": {
      "title": "Saved Article",
      "description": "Articles bookmarked by users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "articleId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "category": { "type": "string" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "articleId", "title", "slug", "savedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or editorial notifications for users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["info", "alert", "editorial"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "ArticleStatus": {
      "title": "Article Status",
      "description": "Metadata for AI articles and editorial review.",
      "type": "object",
      "properties": {
        "articleId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "type": "string", "enum": ["pending_review", "published", "archived"] },
        "aiGenerated": { "type": "boolean" },
        "citations": { "type": "array" },
        "humanEditorId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["articleId", "status", "aiGenerated", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "users/{userId}/savedArticles/{articleId}": {
      "schema": "SavedArticle",
      "description": "Subcollection for bookmarked articles."
    },
    "users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User-specific notifications."
    },
    "articleStatus/{articleId}": {
      "schema": "ArticleStatus",
      "description": "Editorial status and AI metadata for articles."
    },
    "admins/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "email": { "type": "string" }
        }
      },
      "description": "Admin whitelist collection."
    }
  }
}
