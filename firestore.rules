rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Helpers
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admin check: bootstrapped email or entry in /admins collection
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'bbillel87@gmail.com' || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isEditor() {
      return isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin', 'supervisor']);
    }

    // 3. Validation Blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.role in ['reader', 'editor', 'admin', 'supervisor']
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidSavedArticle(data, userId) {
      return data.userId == userId
        && data.articleId is string && data.articleId.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.slug is string && data.slug.size() <= 200
        && data.savedAt == request.time;
    }

    function isValidNotification(data, userId) {
      return data.userId == userId
        && data.title is string && data.title.size() <= 100
        && data.message is string && data.message.size() <= 500
        && data.type in ['info', 'alert', 'editorial']
        && data.read is bool
        && data.createdAt == request.time;
    }

    function isValidArticleStatus(data) {
      return data.articleId is string && data.articleId.size() <= 128
        && data.status in ['pending_review', 'published', 'archived']
        && data.aiGenerated is bool
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    // 4. Resource Matches
    
    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isEditor();
      allow list: if isAdmin();
      
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().role == 'reader'; // Default role for new users
        
      allow update: if isOwner(userId)
        && (
          // Action: Profile Update
          (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
           && incoming().updatedAt == request.time) ||
          // Action: Admin Role Update
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']))
        );
    }

    // Saved Articles
    match /users/{userId}/savedArticles/{articleId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSavedArticle(incoming(), userId);
      allow delete: if isOwner(userId);
    }

    // Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isEditor(); // Only editors/admins can send notifications
      allow update: if isOwner(userId) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
    }

    // Article Status (Master Gate for Review Loop)
    match /articleStatus/{articleId} {
      allow read: if isSignedIn(); // All signed in users can see status (to know if it's published)
      
      allow create: if isEditor();
      
      allow update: if isEditor() && (
        // Action: Review
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'humanEditorId', 'updatedAt'])
         && incoming().status in ['published', 'archived']
         && incoming().humanEditorId == request.auth.uid) ||
        // Action: Metadata Edit
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['citations', 'updatedAt']))
      );
    }

    // Admin List
    match /admins/{userId} {
      allow read: if isAdmin();
    }
  }
}
